{
  "name": "dsh-wb-desk",
  "version": "0.1.0",
  "description": "Agent 原生产物空间：分级写入（新建自动归位 / 修改待确认）+ 固定修订引用。对标 WorkBuddy 资料库的 DSH 插件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown src/index.ts --format esm --out-dir lib"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "library",
    "artifacts"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.14.0",
    "typescript": "^5.7.0"
  }
}
